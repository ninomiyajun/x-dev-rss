{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Anthropic OAuth token (claude setup-token)",
            "pattern": "/(?:sk-ant-oat)\\d{2}-[A-Za-z0-9_-]{20,}/"
          },
          {
            "name": "X auth_token",
            "pattern": "/(?:X_AUTH_TOKEN|auth[_-]?token)[\"'\\s:=]+[0-9a-f]{40}/i"
          },
          {
            "name": "X ct0",
            "pattern": "/(?:X_CT0|ct0\\w{0,20})[\"'\\s:=]+[0-9a-f]{32,}/i"
          },
          {
            "name": "X cookie in JSON export (name before value)",
            "pattern": "/\"name\"\\s*:\\s*\"(?:auth_token|ct0)\"[^{}]{0,200}?\"value\"\\s*:\\s*\"[0-9a-f]{32,}\"/i"
          },
          {
            "name": "X cookie in JSON export (value before name)",
            "pattern": "/\"value\"\\s*:\\s*\"[0-9a-f]{32,}\"[^{}]{0,200}?\"name\"\\s*:\\s*\"(?:auth_token|ct0)\"/i"
          }
        ]
      }
    }
  ]
}
